# Copy to .env and load it however you prefer (direnv, systemd, docker).

# development | production. Production forces HTTPS, secure cookies, TLS
# verification against Proxmox (it refuses to start without it, and without a
# secret key).
RANGE_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development the app writes one to instance/secret_key automatically.
FLASK_SECRET_KEY=

DATABASE_PATH=instance/cyber_range.sqlite

# Number of reverse proxies in front of the app. Leave at 0 unless something
# like nginx is in front and setting X-Forwarded-For — trusting that header
# when nothing sets it lets clients forge their source address and bypass
# every rate limit below.
TRUSTED_PROXIES=0

# --- account policy ---
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15
RESET_TOKEN_HOURS=24
MIN_PASSWORD_LENGTH=12
IDLE_TIMEOUT_MINUTES=60
SESSION_LIFETIME_MINUTES=720
MAX_CONTENT_BYTES=65536

# --- proxmox ---
# simulate = fake the clone/start calls, no hypervisor needed (development)
# api      = talk to the real cluster
PROXMOX_BACKEND=simulate

PROXMOX_HOST=10.1.21.151
PROXMOX_NODE=pve
# e.g. pond@pve!launcher - created by playbooks/pond_least_privilege.yml.
# @pam tokens are refused.
PROXMOX_TOKEN_ID=
# Never commit this. The secret is printed once, into a root-only file, by
# playbooks/pond_least_privilege.yml - do not create the token by hand in the
# GUI, which would skip the scoping and Privilege Separation. Paste it here, or
# export it in the service unit, then shred the file.
PROXMOX_TOKEN_SECRET=

# Only used for full clones; a linked clone inherits the template's storage.
PROXMOX_STORAGE=local-lvm
PROXMOX_FULL_CLONE=0

# Certificate verification is on. The cluster's certificate is signed by its own
# CA, so copy /etc/pve/pve-root-ca.pem from the hypervisor to this host and point
# at it. 0 is refused in production; in development it logs a warning.
PROXMOX_VERIFY_SSL=1
PROXMOX_CA_BUNDLE=/etc/pond/pve-root-ca.pem

# Pool every clone is created in (the token is scoped to it).
PROXMOX_POOL=pond-clones
# Pool holding the challenge templates the token may clone.
PROXMOX_TEMPLATE_POOL=pond-templates
# Extra grants the privilege self-check accepts. They must match
# pond_template_bridges / pond_storages in playbooks/pond_least_privilege.yml.
# Leave the bridges empty if template NICs sit on a VNet in the zone (preferred).
PROXMOX_TEMPLATE_BRIDGES=
PROXMOX_TEMPLATE_STORAGES=local-lvm
# VMs of other projects: never cloned, started or deleted by the app.
PROXMOX_PROTECTED_VMIDS=300-303
# Seconds a passed token-privilege self-check is trusted per worker (0 = every launch).
PROXMOX_PRIVILEGE_CHECK_TTL=300
# Simple SDN zone that holds each clone's private VNet.
PROXMOX_SDN_ZONE=pondz
# Seconds to wait for a clone, stop or delete task.
PROXMOX_TASK_TIMEOUT=300
