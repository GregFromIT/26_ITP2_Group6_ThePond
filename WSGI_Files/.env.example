# Copy to .env and load it however you prefer (direnv, systemd, docker).

# development | production. Production forces HTTPS, secure cookies, TLS
# verification against Proxmox, and refuses to start without a secret key.
RANGE_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development the app writes one to instance/secret_key automatically.
FLASK_SECRET_KEY=

DATABASE_PATH=instance/cyber_range.sqlite

# Number of reverse proxies in front of the app. Leave at 0 unless something
# like nginx is in front and setting X-Forwarded-For — trusting that header
# when nothing sets it lets clients forge their source address and bypass
# every rate limit below.
TRUSTED_PROXIES=0

# --- account policy ---
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15
RESET_TOKEN_HOURS=24
MIN_PASSWORD_LENGTH=12
IDLE_TIMEOUT_MINUTES=60
SESSION_LIFETIME_MINUTES=720
MAX_CONTENT_BYTES=65536

# --- proxmox ---
# simulate = fake the clone/start calls, no hypervisor needed (development)
# api      = talk to the real cluster
PROXMOX_BACKEND=simulate

PROXMOX_HOST=10.1.21.151
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=root@pam!root
# Never commit this. Create the token in Proxmox (Datacenter > Permissions >
# API Tokens) and paste the secret here, or export it in the service unit.
PROXMOX_TOKEN_SECRET=

# Only used for full clones; a linked clone inherits the template's storage.
PROXMOX_STORAGE=local-lvm
PROXMOX_FULL_CLONE=0

# The cluster is reached by IP, so its certificate is almost certainly
# self-signed and verification will fail. Set to 0 only if you accept that
# anyone on the path can impersonate the hypervisor to this app.
PROXMOX_VERIFY_SSL=0
